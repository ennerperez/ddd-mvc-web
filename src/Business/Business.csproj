<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\src\.imports\Template.props"/>
  <Import Project="..\..\src\.imports\Template.targets"/>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj"/>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj"/>
    <ProjectReference Include="..\Persistence\Persistence.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Update="Reqnroll" Version="2.4.1" />
    <PackageReference Update="Reqnroll.Microsoft.Extensions.DependencyInjection" Version="2.4.1" />
    <PackageReference Update="Reqnroll.Tools.MsBuild.Generation" Version="2.4.1" />
    <PackageReference Update="Reqnroll.xUnit" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup Label="ConditionalReferences">
    <PackageReference Condition="'$(UsingLocalization)' == 'true'" Include="Microsoft.Extensions.Localization" Version="9.0.7" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsingIdentity)' == 'false'">
    <Compile Remove="Requests\Identity\**"/>
    <EmbeddedResource Remove="Requests\Identity\**"/>
    <None Remove="Requests\Identity\**"/>
  </ItemGroup>

</Project>
